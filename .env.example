# Local Homebrew Postgres (npm start). Use npm run db:psql for the CLI.
DATABASE_URL="postgresql://vidya:vidya@localhost:5432/vidya"

# API
PORT=4000
JWT_SECRET="dev-only-jwt-secret-change-me"

# Leave SMTP_HOST unset to log mail to the API console.
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_FROM="Vidya <noreply@vidya.local>"

# Clients
NEXT_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000"
