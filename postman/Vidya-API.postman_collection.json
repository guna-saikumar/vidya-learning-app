{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Vidya API",
    "description": "# Vidya API\n\nProduction: `https://vidya-api-kohl.vercel.app`\nLocal: `http://localhost:4000`\n\n## Setup\n1. Set collection vars `adminPassword` / `studentPassword` from seed (`packages/db/prisma/seed.ts`) — **do not commit secrets**.\n2. Run **Admin Auth → login** (or Student login) — tokens auto-save.\n3. Hit Dashboard / protected routes.\n\n## Docs\n- Swagger UI: `{{baseUrl}}/docs`\n- OpenAPI JSON: `{{baseUrl}}/docs-json`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://vidya-api-kohl.vercel.app" },
    { "key": "studentEmail", "value": "student@vidya.test" },
    { "key": "studentPassword", "value": "" },
    { "key": "adminEmail", "value": "admin@vidya.edu.in" },
    { "key": "adminPassword", "value": "" },
    { "key": "superAdminEmail", "value": "superadmin@vidya.edu.in" },
    { "key": "superAdminPassword", "value": "" },
    { "key": "adminName", "value": "Dr. Ramesh Sharma" },
    { "key": "adminDepartment", "value": "Academic Director · AP SCERT Division" },
    { "key": "otp", "value": "123456" },
    { "key": "studentToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health & Docs",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness probe."
          }
        },
        {
          "name": "GET /health/db",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/db",
            "description": "Database connectivity probe."
          }
        },
        {
          "name": "GET /docs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/docs",
            "description": "Swagger UI (HTML)."
          }
        },
        {
          "name": "GET /docs-json",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/docs-json",
            "description": "OpenAPI JSON."
          }
        }
      ]
    },
    {
      "name": "1. Curriculum",
      "item": [
        {
          "name": "GET /api/classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/classes",
            "description": "List classes + curriculum stats (public)."
          }
        }
      ]
    },
    {
      "name": "2. Student Auth",
      "item": [
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('studentToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Student login. Saves `studentToken`."
          }
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Current student profile."
          }
        }
      ]
    },
    {
      "name": "3. Student Dashboard",
      "item": [
        {
          "name": "GET /api/dashboard",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dashboard",
            "description": "Student home: identity + curriculum overview."
          }
        }
      ]
    },
    {
      "name": "4. Admin Auth",
      "item": [
        {
          "name": "POST /api/admin/auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{adminName}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"department\": \"{{adminDepartment}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/auth/register",
            "description": "Register admin (sends OTP)."
          }
        },
        {
          "name": "POST /api/admin/auth/verify-email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/auth/verify-email"
          }
        },
        {
          "name": "POST /api/admin/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('adminToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/auth/login",
            "description": "Admin login. Saves `adminToken`."
          }
        },
        {
          "name": "POST /api/admin/auth/forgot-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/auth/forgot-password"
          }
        },
        {
          "name": "POST /api/admin/auth/reset-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/auth/reset-password"
          }
        },
        {
          "name": "GET /api/admin/auth/me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/auth/me"
          }
        }
      ]
    },
    {
      "name": "5. Admin Dashboard",
      "item": [
        {
          "name": "GET /api/admin/ping",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/ping",
            "description": "Admin JWT + role gate check."
          }
        },
        {
          "name": "GET /api/admin/dashboard",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard?recentLimit=8",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard"],
              "query": [
                { "key": "recentLimit", "value": "8", "description": "1–50 recent users" }
              ]
            },
            "description": "Admin home KPIs: curriculum, users by role, materials stub, recentUsers."
          }
        },
        {
          "name": "GET /api/admin/dashboard/users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard/users?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard", "users"],
              "query": [
                { "key": "role", "value": "STUDENT", "disabled": true, "description": "STUDENT | ADMIN | SUPER_ADMIN" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "Paginated users for dashboard tables."
          }
        },
        {
          "name": "GET /api/admin/dashboard/users (admins only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard/users?role=ADMIN&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard", "users"],
              "query": [
                { "key": "role", "value": "ADMIN" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    }
  ]
